rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() {
      return signedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : {};
    }
    function isUserSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }
    function role(r) { return signedIn() && profile().role == r; }
    function anyRole(roles) { return signedIn() && profile().role in roles; }
    function schoolMember(schoolId) {
      return signedIn() && profile().schoolId == schoolId;
    }
    function validId(id) { return id is string && id.size() <= 128; }
    function sameSchool() {
      return schoolMember(resource.data.schoolId);
    }
    // --- Subscription entitlement (P1-B) ---
    // Mirrors the client-side evaluateSubscription() state machine so that
    // Firestore itself (not just the React UI) enforces access for
    // SUSPENDED/CANCELLED/expired/malformed/missing subscriptions. Dates are
    // stored as native Firestore Timestamps (not ISO strings) because rules
    // have no string-to-timestamp parser and can only compare request.time
    // against timestamp-typed fields.
    function subscriptionExists(schoolId) {
      return exists(/databases/$(database)/documents/schoolSubscriptions/$(schoolId));
    }
    function subscriptionData(schoolId) {
      return get(/databases/$(database)/documents/schoolSubscriptions/$(schoolId)).data;
    }
    function validSubscriptionShape(data) {
      return data.schoolId is string
        && data.planId is string
        && data.status is string
        && data.currentPeriodEnd is timestamp
        && data.provider is string;
    }
    function withinGrace(data) {
      return ('gracePeriodEnd' in data) && data.gracePeriodEnd is timestamp
        && request.time <= data.gracePeriodEnd;
    }
    function subscriptionEntitled(schoolId) {
      return subscriptionExists(schoolId)
        && validSubscriptionShape(subscriptionData(schoolId))
        && (
          (subscriptionData(schoolId).status in ['TRIAL', 'ACTIVE']
            && (request.time <= subscriptionData(schoolId).currentPeriodEnd || withinGrace(subscriptionData(schoolId))))
          || (subscriptionData(schoolId).status == 'PAST_DUE'
            && (request.time <= subscriptionData(schoolId).currentPeriodEnd || withinGrace(subscriptionData(schoolId))))
          || (subscriptionData(schoolId).status == 'GRACE_PERIOD' && withinGrace(subscriptionData(schoolId)))
        );
    }
    // Full entitlement check for operational data: correct school AND an
    // active/eligible subscription. Role permissions are applied separately
    // and unchanged - this never replaces them, only adds a further condition.
    function entitled(schoolId) {
      return schoolMember(schoolId) && subscriptionEntitled(schoolId);
    }
    // One-time bootstrap exemption for the legitimate SetupWizard flow of a
    // brand-new school. It applies ONLY to `create` operations (never read or
    // update) for a document that does not yet exist, ONLY for that school's
    // own freshly-registered SUPER_ADMIN, and ONLY while no subscription
    // document exists yet for that school. Once any schoolSubscriptions/{id}
    // document exists (e.g. SUSPENDED, CANCELLED, or any other status), this
    // can never fire again for that school - it cannot be replayed to regain
    // access, and it never grants read access to pre-existing data.
    function newSchoolBootstrap(schoolId) {
      return role('SUPER_ADMIN') && profile().schoolId == schoolId && !subscriptionExists(schoolId);
    }
    function incomingSchool() {
      return schoolMember(request.resource.data.schoolId);
    }
    function staff() {
      return anyRole(['SUPER_ADMIN', 'ADMIN', 'PRINCIPAL', 'TEACHER',
        'ACCOUNTANT', 'RECEPTIONIST']);
    }
    function schoolReader() {
      return anyRole(['SUPER_ADMIN', 'ADMIN', 'PRINCIPAL', 'TEACHER',
        'ACCOUNTANT', 'RECEPTIONIST', 'TRANSPORT_MANAGER']);
    }
    function studentReader() {
      return schoolReader();
    }
    function staffReader() {
      return anyRole(['SUPER_ADMIN', 'ADMIN', 'PRINCIPAL', 'TEACHER',
        'ACCOUNTANT', 'RECEPTIONIST']);
    }
    function manager() { return anyRole(['SUPER_ADMIN', 'ADMIN', 'PRINCIPAL']); }
    function financeReader() {
      return anyRole(['SUPER_ADMIN', 'ADMIN', 'PRINCIPAL', 'ACCOUNTANT', 'RECEPTIONIST']);
    }
    function feeCollector() {
      return anyRole(['SUPER_ADMIN', 'ADMIN', 'PRINCIPAL', 'ACCOUNTANT', 'RECEPTIONIST']);
    }
    function feeEditor() {
      return anyRole(['SUPER_ADMIN', 'ADMIN', 'PRINCIPAL', 'ACCOUNTANT']);
    }
    function expenseCreator() {
      return anyRole(['SUPER_ADMIN', 'ADMIN', 'ACCOUNTANT']);
    }
    function accountsReader() {
      return anyRole(['SUPER_ADMIN', 'ADMIN', 'PRINCIPAL', 'ACCOUNTANT']);
    }
    function sessionBelongsToSchool(schoolId, sessionId) {
      return sessionId is string
        && exists(/databases/$(database)/documents/academicSessions/$(sessionId))
        && get(/databases/$(database)/documents/academicSessions/$(sessionId)).data.schoolId == schoolId;
    }
    function classBelongsToSchool(schoolId, classId) {
      return classId is string
        && exists(/databases/$(database)/documents/classes/$(classId))
        && get(/databases/$(database)/documents/classes/$(classId)).data.schoolId == schoolId;
    }
    function sectionBelongsToClass(schoolId, classId, sectionId) {
      return sectionId is string
        && exists(/databases/$(database)/documents/sections/$(sectionId))
        && get(/databases/$(database)/documents/sections/$(sectionId)).data.schoolId == schoolId
        && get(/databases/$(database)/documents/sections/$(sectionId)).data.classId == classId;
    }
    function categoryBelongsToSchool(schoolId, categoryId) {
      return categoryId is string
        && exists(/databases/$(database)/documents/feeCategories/$(categoryId))
        && get(/databases/$(database)/documents/feeCategories/$(categoryId)).data.schoolId == schoolId;
    }
    function studentBelongsToSchool(schoolId, studentId) {
      return studentId is string
        && exists(/databases/$(database)/documents/students/$(studentId))
        && get(/databases/$(database)/documents/students/$(studentId)).data.schoolId == schoolId;
    }
    function structureBelongsToSchool(schoolId, structureId) {
      return structureId is string
        && exists(/databases/$(database)/documents/feeStructures/$(structureId))
        && get(/databases/$(database)/documents/feeStructures/$(structureId)).data.schoolId == schoolId;
    }
    function validFeeAssignment(data) {
      return data.schoolId == profile().schoolId
        && data.academicSessionId is string
        && sessionBelongsToSchool(data.schoolId, data.academicSessionId)
        && studentBelongsToSchool(data.schoolId, data.studentId)
        && classBelongsToSchool(data.schoolId, data.classId)
        && structureBelongsToSchool(data.schoolId, data.feeStructureId)
        && get(/databases/$(database)/documents/feeStructures/$(data.feeStructureId)).data.schoolId == data.schoolId
        && get(/databases/$(database)/documents/feeStructures/$(data.feeStructureId)).data.academicSessionId == data.academicSessionId
        && get(/databases/$(database)/documents/feeStructures/$(data.feeStructureId)).data.classId == data.classId
        && get(/databases/$(database)/documents/students/$(data.studentId)).data.classId == data.classId
        && (!('sectionId' in data) || data.sectionId == null
          || get(/databases/$(database)/documents/students/$(data.studentId)).data.sectionId == data.sectionId)
        && (!('feeCategoryId' in data) || data.feeCategoryId == null
          || get(/databases/$(database)/documents/feeStructures/$(data.feeStructureId)).data.feeCategoryId == data.feeCategoryId);
    }
    function validFeeItem(data) {
      return validFeeAssignment(data)
        && data.feeAssignmentId is string
        && getAfter(/databases/$(database)/documents/feeAssignments/$(data.feeAssignmentId)).data.studentId == data.studentId
        && getAfter(/databases/$(database)/documents/feeAssignments/$(data.feeAssignmentId)).data.feeStructureId == data.feeStructureId;
    }
    function validFeeStructure(data) {
      return data.schoolId == profile().schoolId
        && data.academicSessionId is string
        && sessionBelongsToSchool(data.schoolId, data.academicSessionId)
        && data.classId is string
        && classBelongsToSchool(data.schoolId, data.classId)
        && (!('sectionId' in data) || data.sectionId == null
          || sectionBelongsToClass(data.schoolId, data.classId, data.sectionId))
        && (!('feeCategoryId' in data) || data.feeCategoryId == null
          || categoryBelongsToSchool(data.schoolId, data.feeCategoryId));
    }
    function validDiscount(data) {
      return data.schoolId == profile().schoolId
        && data.academicSessionId is string
        && sessionBelongsToSchool(data.schoolId, data.academicSessionId)
        && data.name is string
        && data.value is number
        && data.value >= 0
        && (!('type' in data) || data.type in ['PERCENTAGE', 'FIXED', 'FIXED_AMOUNT',
          'SCHOLARSHIP', 'SIBLING', 'STAFF_CHILD', 'CUSTOM'])
        && ((!('type' in data) || data.type == 'PERCENTAGE') ? data.value <= 100 : true)
        && (!('feeCategoryId' in data) || data.feeCategoryId == null
          || categoryBelongsToSchool(data.schoolId, data.feeCategoryId))
        && (!('feeStructureId' in data) || data.feeStructureId == null
          || structureBelongsToSchool(data.schoolId, data.feeStructureId));
    }
    function validConcession(data) {
      return data.schoolId == profile().schoolId
        && data.academicSessionId is string
        && sessionBelongsToSchool(data.schoolId, data.academicSessionId)
        && data.studentId is string
        && studentBelongsToSchool(data.schoolId, data.studentId)
        && data.feeItemId is string
        && get(/databases/$(database)/documents/feeItems/$(data.feeItemId)).data.schoolId == data.schoolId
        && get(/databases/$(database)/documents/feeItems/$(data.feeItemId)).data.studentId == data.studentId
        && get(/databases/$(database)/documents/feeItems/$(data.feeItemId)).data.academicSessionId == data.academicSessionId
        && data.concessionAmount is number
        && data.concessionAmount >= 0
        && data.originalAmount is number
        && data.concessionAmount <= data.originalAmount
        && data.payableAmount is number
        && data.payableAmount >= 0
        && data.payableAmount <= data.originalAmount;
    }
    function validPayment(data) {
      return data.schoolId == profile().schoolId
        && data.studentId is string
        && data.academicSessionId is string
        && studentBelongsToSchool(data.schoolId, data.studentId)
        && sessionBelongsToSchool(data.schoolId, data.academicSessionId)
        && data.amountReceived is number
        && data.amountReceived > 0
        && data.allocatedAmount == data.amountReceived
        && data.idempotencyKey is string
        && data.idempotencyKey.size() > 0
        && data.status == 'COMPLETED';
    }
    function validReceipt(id, data) {
      return id == 'receipt_' + data.schoolId + '_' + data.paymentId
        && data.schoolId == profile().schoolId
        && data.paymentId is string
        && getAfter(/databases/$(database)/documents/feePayments/$(data.paymentId)).data.schoolId == data.schoolId
        && getAfter(/databases/$(database)/documents/feePayments/$(data.paymentId)).data.receiptId == id
        && getAfter(/databases/$(database)/documents/feePayments/$(data.paymentId)).data.receiptNumber == data.receiptNumber
        && getAfter(/databases/$(database)/documents/feePayments/$(data.paymentId)).data.studentId == data.studentId
        && getAfter(/databases/$(database)/documents/feePayments/$(data.paymentId)).data.academicSessionId == data.academicSessionId
        && getAfter(/databases/$(database)/documents/feePayments/$(data.paymentId)).data.amountReceived == data.netPaid
        && getAfter(/databases/$(database)/documents/feePayments/$(data.paymentId)).data.status == 'COMPLETED'
        && data.receiptNumber is string
        && data.receiptNumber.size() > 0
        && data.studentId is string
        && data.netPaid is number
        && data.netPaid > 0
        && data.status == 'ACTIVE';
    }
    function validPaymentStateTransition(id, data) {
      return ('lastPaymentId' in data)
        && data.lastPaymentId is string
        && ('lastPaymentItemId' in data)
        && data.lastPaymentItemId is string
        && getAfter(/databases/$(database)/documents/feePaymentItems/$(data.lastPaymentItemId)).data.paymentId == data.lastPaymentId
        && getAfter(/databases/$(database)/documents/feePaymentItems/$(data.lastPaymentItemId)).data.feeItemId == id
        && getAfter(/databases/$(database)/documents/feePaymentItems/$(data.lastPaymentItemId)).data.studentId == data.studentId
        && getAfter(/databases/$(database)/documents/feePaymentItems/$(data.lastPaymentItemId)).data.allocatedAmount is number;
    }
    function validPaymentItem(id, data) {
      return id == 'pay_item_' + data.paymentId + '_' + data.feeItemId
        && data.schoolId == profile().schoolId
        && data.paymentId is string
        && data.feePaymentId == data.paymentId
        && getAfter(/databases/$(database)/documents/feePayments/$(data.paymentId)).data.schoolId == data.schoolId
        && getAfter(/databases/$(database)/documents/feePayments/$(data.paymentId)).data.studentId == data.studentId
        && getAfter(/databases/$(database)/documents/feePayments/$(data.paymentId)).data.academicSessionId == data.academicSessionId
        && data.feeItemId is string
        && get(/databases/$(database)/documents/feeItems/$(data.feeItemId)).data.schoolId == data.schoolId
        && get(/databases/$(database)/documents/feeItems/$(data.feeItemId)).data.studentId == data.studentId
        && get(/databases/$(database)/documents/feeItems/$(data.feeItemId)).data.academicSessionId == data.academicSessionId
        && data.allocatedAmount is number
        && data.allocatedAmount > 0;
    }

    match /schools/{schoolId} {
      allow read: if schoolMember(schoolId);
      // Bootstrap is possible only after Auth and the matching first-admin
      // profile have been created.
      allow create: if validId(schoolId) && signedIn()
        && request.resource.data.isConfigured == true
        && profile().schoolId == schoolId
        && role('SUPER_ADMIN');
      allow update: if schoolMember(schoolId) && manager();
      allow delete: if false;
    }

    match /users/{userId} {
      allow read: if isUserSelf(userId) ||
        (manager() && schoolMember(resource.data.schoolId));
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.schoolId is string
        && !exists(/databases/$(database)/documents/schools/$(request.resource.data.schoolId))
        && request.resource.data.role == 'SUPER_ADMIN';
      allow update: if (
          manager() && request.auth.uid != userId
          && sameSchool() && incomingSchool()
          && (role('SUPER_ADMIN')
            || (resource.data.role != 'SUPER_ADMIN'
              && request.resource.data.role != 'SUPER_ADMIN'))
        )
        || (
          isUserSelf(userId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'phone', 'avatarUrl', 'updatedAt', 'lastLoginAt'])
        );
      allow delete: if false;
    }

    match /academicSessions/{id} {
      allow read: if schoolReader() && sameSchool() && entitled(resource.data.schoolId);
      allow create: if manager() && incomingSchool() && validId(id)
        && (entitled(request.resource.data.schoolId) || newSchoolBootstrap(request.resource.data.schoolId));
      allow update: if manager() && incomingSchool() && validId(id) && entitled(request.resource.data.schoolId);
      allow delete: if false;
    }
    match /classes/{id} {
      allow read: if schoolReader() && sameSchool() && entitled(resource.data.schoolId);
      allow create: if manager() && incomingSchool() && validId(id)
        && (entitled(request.resource.data.schoolId) || newSchoolBootstrap(request.resource.data.schoolId));
      allow update: if manager() && incomingSchool() && validId(id) && entitled(request.resource.data.schoolId);
      allow delete: if manager() && sameSchool() && entitled(resource.data.schoolId);
    }
    match /sections/{id} {
      allow read: if schoolReader() && sameSchool() && entitled(resource.data.schoolId);
      allow create: if manager() && incomingSchool() && validId(id)
        && (entitled(request.resource.data.schoolId) || newSchoolBootstrap(request.resource.data.schoolId));
      allow update: if manager() && incomingSchool() && validId(id) && entitled(request.resource.data.schoolId);
      allow delete: if manager() && sameSchool() && entitled(resource.data.schoolId);
    }
    match /subjects/{id} {
      allow read: if schoolReader() && sameSchool() && entitled(resource.data.schoolId);
      allow create: if manager() && incomingSchool() && validId(id)
        && (entitled(request.resource.data.schoolId) || newSchoolBootstrap(request.resource.data.schoolId));
      allow update: if manager() && incomingSchool() && validId(id) && entitled(request.resource.data.schoolId);
      allow delete: if manager() && sameSchool() && entitled(resource.data.schoolId);
    }
    match /students/{id} {
      allow read: if studentReader() && schoolMember(resource.data.schoolId) && entitled(resource.data.schoolId);
      allow create: if staff() && incomingSchool() && validId(id)
        && (entitled(request.resource.data.schoolId) || newSchoolBootstrap(request.resource.data.schoolId));
      allow update: if staff() && sameSchool() && incomingSchool() && entitled(request.resource.data.schoolId);
      allow delete: if manager() && sameSchool() && entitled(resource.data.schoolId);
    }
    match /staff/{id} {
      allow read: if staffReader() && schoolMember(resource.data.schoolId) && entitled(resource.data.schoolId);
      allow create: if manager() && incomingSchool() && validId(id)
        && (entitled(request.resource.data.schoolId) || newSchoolBootstrap(request.resource.data.schoolId));
      allow update: if manager() && incomingSchool() && validId(id) && entitled(request.resource.data.schoolId);
      allow delete: if manager() && sameSchool() && entitled(resource.data.schoolId);
    }
    match /attendance/{id} {
      allow read: if staffReader() && sameSchool() && entitled(resource.data.schoolId);
      allow create, update: if staff() && incomingSchool() && validId(id) && entitled(request.resource.data.schoolId);
      allow delete: if manager() && sameSchool() && entitled(resource.data.schoolId);
    }
    match /attendanceDaily/{id} {
      allow read: if staffReader() && sameSchool() && entitled(resource.data.schoolId);
      allow create, update: if staff() && incomingSchool() && validId(id) && entitled(request.resource.data.schoolId);
      allow delete: if manager() && sameSchool() && entitled(resource.data.schoolId);
    }
    match /settings/{schoolId} {
      allow read: if schoolMember(schoolId);
      allow create, update: if manager() && schoolMember(schoolId);
      allow delete: if false;
    }
    match /auditLogs/{id} {
      allow read: if manager() && sameSchool();
      allow create: if staff() && incomingSchool() && validId(id);
      allow update, delete: if false;
    }

    // Subscription state is readable by the associated school only. Writes
    // are reserved for a trusted Admin SDK/webhook boundary, not the browser.
    match /schoolSubscriptions/{schoolId} {
      allow read: if schoolMember(schoolId);
      allow create, update, delete: if false;
    }
    match /platformAdmins/{uid} {
      allow read, write: if false;
    }

    match /financialSettings/{id} {
      allow read: if accountsReader() && sameSchool();
      allow create: if anyRole(['SUPER_ADMIN', 'ADMIN'])
        && incomingSchool() && validId(id)
        && (!('academicSessionId' in request.resource.data)
          || sessionBelongsToSchool(request.resource.data.schoolId, request.resource.data.academicSessionId));
      allow update: if (
          anyRole(['SUPER_ADMIN', 'ADMIN'])
          && incomingSchool() && validId(id)
          && (!('academicSessionId' in request.resource.data)
            || sessionBelongsToSchool(request.resource.data.schoolId, request.resource.data.academicSessionId))
        ) || (
          feeCollector() && sameSchool() && incomingSchool() && validId(id)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['currentReceiptCounter', 'updatedAt'])
          && request.resource.data.currentReceiptCounter == resource.data.currentReceiptCounter + 1
        );
      allow delete: if false;
    }
    match /feeCategories/{id} {
      allow read: if financeReader() && sameSchool();
      allow create: if feeEditor() && incomingSchool() && validId(id)
        && request.resource.data.name is string
        && request.resource.data.code is string;
      allow update: if feeEditor() && sameSchool() && incomingSchool()
        && request.resource.data.schoolId == resource.data.schoolId
        && request.resource.data.code == resource.data.code
        && validId(id);
      allow delete: if false;
    }
    match /feeStructures/{id} {
      allow read: if financeReader() && sameSchool();
      allow create: if feeEditor() && incomingSchool() && validId(id)
        && validFeeStructure(request.resource.data);
      allow update: if feeEditor() && sameSchool() && incomingSchool()
        && validFeeStructure(request.resource.data);
      allow delete: if false;
    }
    match /feeAssignments/{id} {
      allow read: if financeReader() && sameSchool();
      allow create: if feeEditor() && incomingSchool() && validId(id)
        && validFeeAssignment(request.resource.data)
        && get(/databases/$(database)/documents/feeStructures/$(request.resource.data.feeStructureId)).data.status == 'ACTIVE';
      allow update: if feeEditor() && sameSchool() && incomingSchool()
        && validFeeAssignment(request.resource.data)
        && request.resource.data.schoolId == resource.data.schoolId
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.feeStructureId == resource.data.feeStructureId;
      allow delete: if false;
    }
    match /feeItems/{id} {
      allow read: if financeReader() && sameSchool();
      allow create: if feeEditor() && incomingSchool() && validId(id)
        && validFeeItem(request.resource.data);
      allow update: if feeEditor() && sameSchool() && incomingSchool()
        && validFeeItem(request.resource.data)
        && request.resource.data.schoolId == resource.data.schoolId
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.feeAssignmentId == resource.data.feeAssignmentId
        && (
          (!request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['paidAmount', 'balance', 'status', 'lastPaymentId', 'lastPaymentItemId']))
          || validPaymentStateTransition(id, request.resource.data)
        );
      allow delete: if false;
    }
    match /feeDiscounts/{id} {
      allow read: if financeReader() && sameSchool();
      allow create: if manager() && incomingSchool() && validId(id)
        && validDiscount(request.resource.data);
      allow update: if manager() && sameSchool() && incomingSchool()
        && request.resource.data.schoolId == resource.data.schoolId
        && validDiscount(request.resource.data);
      allow delete: if false;
    }
    match /feeConcessions/{id} {
      allow read: if financeReader() && sameSchool();
      allow create: if manager() && incomingSchool() && validId(id)
        && validConcession(request.resource.data)
        && !exists(/databases/$(database)/documents/feeConcessions/$(id));
      allow update: if manager() && sameSchool() && incomingSchool()
        && request.resource.data.schoolId == resource.data.schoolId
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.feeItemId == resource.data.feeItemId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt', 'updatedBy']);
      allow delete: if false;
    }
    match /feePayments/{id} {
      allow read: if financeReader() && (resource == null || sameSchool());
      allow create: if feeCollector() && incomingSchool() && validId(id)
        && validPayment(request.resource.data);
      allow update: if anyRole(['SUPER_ADMIN', 'ADMIN']) && sameSchool()
        && resource.data.status != 'CANCELLED'
        && request.resource.data.status == 'CANCELLED'
        && request.resource.data.cancelledBy == request.auth.uid
        && request.resource.data.cancellationReason is string
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'cancelledAt', 'cancelledBy', 'cancellationReason', 'updatedAt']);
      allow delete: if false;
    }
    match /feePaymentItems/{id} {
      allow read: if financeReader() && sameSchool();
      allow create: if feeCollector() && incomingSchool() && validId(id)
        && validPaymentItem(id, request.resource.data);
      allow update, delete: if false;
    }
    match /feeAdvances/{id} {
      allow read: if financeReader() && sameSchool();
      allow create, update: if feeCollector() && incomingSchool() && validId(id);
      allow delete: if false;
    }
    match /receipts/{id} {
      allow read: if financeReader() && sameSchool();
      allow create: if feeCollector() && incomingSchool() && validId(id)
        && validReceipt(id, request.resource.data);
      allow update: if false;
      allow delete: if false;
    }
    match /expenses/{id} {
      allow read: if accountsReader() && sameSchool();
      allow create: if expenseCreator() && incomingSchool() && validId(id);
      allow update: if manager() && sameSchool() && incomingSchool() && validId(id);
      allow delete: if manager() && sameSchool();
    }
    match /expenseCategories/{id} {
      allow read: if accountsReader() && sameSchool();
      allow create, update: if manager() && incomingSchool() && validId(id);
      allow delete: if manager() && sameSchool();
    }
    match /cashBook/{id} {
      allow read: if accountsReader() && sameSchool();
      allow create, update: if feeCollector() && incomingSchool() && validId(id);
      allow delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
